# ---- big tools you can reinstall (never upload) ----
ComfyUI_windows_portable/
**/ComfyUI*/
# downloaded AI model weights: the top-level D:\star\models folder and the weight files themselves
# (never "**/models/": that also hid the source folders apps/agentic_core/models and apps/api/src/database/models)
/models/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.bin
# small models the app ships with (YuNet face finder, MIT, 230 KB)
!apps/animation_studio/studio/autoclip/assets/*.onnx

# ---- build output and installed packages ----
node_modules/
.next/
out/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---- videos, audio, zips, renders ----
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.zip
*.7z
*.tgz

# ---- private: keys, logins, cookies, tokens ----
.env
.env.*
!.env.example
*cookies*.txt
*client_secret*.json
*token*.json
*.pem
*.key
secrets/

# ---- app data (jobs, clips, channel logins) ----
**/autoclip/jobs/
**/autoclip/settings.json
**/autoclip/youtube*.json
/projects/
/outputs/
apps/reelmimic/projects/*
!apps/reelmimic/projects/.gitkeep

# ---- system junk ----
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tsbuildinfo
next-env.d.ts
*.part
yt-test.txt

# unzipped update packs
avos-all-updates/
avos-architecture-updated*/


# runtime state written by the studio (provider health, caches)
.avos/
