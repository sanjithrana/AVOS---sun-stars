# Copy to .env.local (optional).
#
# Leave NEXT_PUBLIC_API_URL unset to use the same host that served the
# page on port 8001 (docker-compose's API port) - this also works when
# you open the UI from another device on your network.
# NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
# NEXT_PUBLIC_API_PORT=8001
