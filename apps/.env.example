# Copy to apps/.env (docker compose reads it). Every line is optional: the studio runs on free and local
# models, and anything you paste in Settings -> API keys wins over this file. Never commit your real .env.

# Text AI (pick any; Ollama runs on your computer for free)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLAMACPP_URL=

# Pictures and video
FAL_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
POLLINATIONS_TOKEN=
IMAGE_SERVICE_URL=

# Your own GPU (ComfyUI) and model downloads
COMFYUI_URL=
HF_TOKEN=
GPU_WORKER_TOKEN=
